{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/fraud/(.*)$",
      "target": "/fraud/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false,
      "timeout": 60000
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    }
  ]
}
