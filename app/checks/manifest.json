{
  "_version": "1.49.0",
  "sap.app": {
    "id": "ap.sentinel.checks",
    "type": "application",
    "title": "Check history",
    "description": "AP Check History for Duplicate Invoice Detection Agent",
    "dataSources": {
      "mainService": {
        "uri": "/fraud/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "ChecksList",
          "pattern": ":?query:",
          "target": "ChecksList"
        }
      ],
      "targets": {
        "ChecksList": {
          "type": "Component",
          "id": "ChecksList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Checks",
              "initialLoad": "Enabled"
            }
          }
        }
      }
    }
  }
}
