{
  "name": "blus-invoice-agent",
  "version": "1.0.0",
  "description": "Blus Invoice Agent: catches duplicate and split invoices before they get paid",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node -e \"console.log('Build succeeded')\"",
    "test": "node --test test/acceptance.test.js"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@google/genai": "^2.32.0",
    "@napi-rs/canvas": "^1.1.0",
    "@sap/cds": "^10.2.2",
    "@sap/xssec": "^4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "reviewer": {
            "password": "reviewer",
            "roles": [
              "APClerk",
              "APController",
              "Auditor"
            ]
          },
          "clerk": {
            "password": "clerk",
            "roles": [
              "APClerk"
            ]
          },
          "controller": {
            "password": "controller",
            "roles": [
              "APController"
            ]
          },
          "auditor": {
            "password": "auditor",
            "roles": [
              "Auditor"
            ]
          }
        }
      }
    }
  }
}
